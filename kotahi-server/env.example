# --- Backend (Go) ---

# HTTP server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# MongoDB
MONGODB_URI=mongodb://admin:password@mongodb:27017/video_player?authSource=admin
MONGODB_DATABASE=video_player

# JWT (set JWT_SECRET to a long random string in production)
JWT_SECRET=dev-only-change-in-production
JWT_EXPIRATION_HOURS=24

# Mailgun (contact / feedback; optional for local dev)
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
EMAIL_FROM=
EMAIL_TO=
EMAIL_FROM_NAME=Tokotoko Support

# --- Frontend (Next.js; not read by the Go server) ---

POSTHOG_KEY=your_posthog_project_key_here
POSTHOG_HOST=https://app.posthog.com
SITE_URL=http://localhost:3000
